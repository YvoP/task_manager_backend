{% include 'partials/_addProjectUserModal.html.twig' %}
<div class="d-none d-lg-block col-lg-3 col-xl-2 flex-column shadow-sm z-1">
    <div class="container h-100">
        <div class="row">
            <div class="col pt-4">
                <p class="h4">{{ 'sidebar.projects' | trans }}</p>
                <ul class="list-unstyled">
                    {% for userProject in get_projects(user) %}
                        {% if not userProject.isArchived %}
                            {% if project is defined and project is not null %}
                                {% set isOpen = userProject == project %}
                            {% else %}
                                {% set isOpen = false %}
                            {% endif %}
                            {% include 'partials/_projectItem.html.twig' with {'open': isOpen } %}
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% if project is defined and project is not null %}
            <div class="row">
                <div class="col pt-4">
                    <p class="h4">{{ 'sidebar.chats' | trans }}</p>
                    <ul>
                        {% for chats in get_chats(project, user) %}
                            <li>
                                <a href="{{ path('app_project_tasks', {id: project.id}) }}">{{ chats.name }}</a>
                            </li>
                        {% endfor %}
                        {% for collegue in get_unstarted_chats(project, user) %}
                            <li>
                                <a href="{{ path('app_project_tasks', {id: project.id}) }}">{{ collegue.user.username }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}
        <div class="row vh-100">
            <div class="row mx-auto pb-4 mt-auto sticky-bottom">
                <div class="btn-group-vertical">
                    {% if project is defined and project is not null and is_admin(project, user) %}
                        <div class="btn-group">
                            <a href="#" class="btn btn-outline-secondary" data-bs-toggle="modal"
                               data-bs-target="#addProjectUserModal">
                                <i class="fa-solid fa-user-plus"></i></a>
                            <a href="{{ path('app_project_edit', {id: project.id}) }}" class="btn btn-outline-warning">
                                <i class="fa-solid fa-gear"></i></a>
                        </div>
                    {% endif %}
                    <a href="{{ path('app_project_new') }}" class="btn btn-outline-primary">New project</a>
                </div>
            </div>
        </div>
    </div>
</div>
