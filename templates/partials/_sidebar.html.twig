<div class="d-none d-lg-block col-lg-3 col-xl-2 flex-column shadow">
    <div class="container">
        <div class="row">
            <div class="col pt-4">
                <p class="h4">{{ 'sidebar.projects' | trans }}</p>
                <ul>
                {% for project in get_projects(user) %}
                    <li><a href="{{ path('app_project_tasks', {projectId: project.id}) }}">{{ project.name }}</a></li>
                {% endfor %}
                </ul>
            </div>
        </div>
        <div class="row">
            <div class="col pt-4">
                <p class="h4">{{ 'sidebar.chats' | trans }}</p>
            </div>
        </div>
    </div>
</div>
