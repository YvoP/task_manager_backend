{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
    <div class="row my-4 px-5 overflow-x-hidden">
        <div class="col-3 position-relative search-field">
            <input class="form-control search-input inside-shadow py-2" type="text" placeholder="Search...">
            <a class="position-absolute search-icon translate-middle text-body" href="#">
                <i class="fa-solid fa-search"></i>
            </a>
        </div>
        <div class="col-auto ms-auto">
            <a class="text-decoration-none text-body" href="#">
                <i class="fa-solid fa-filter fa-2xl"></i>
            </a>
            <a class="btn btn-primary fw-bold py-2" href="{{ path('app_project_new_task', {id: project.id}) }}">{{ 'button.new_task' | trans({}, 'tasks') }} <i class="fa-solid fa-plus"></i></a>
        </div>
    </div>
    <div class="row px-5">
        {% for status in statuses %}
            <div class="col-lg-4">
                <div class="col sticky-top bg-blur">
                    <p class="mt-3 px-4 fs-1 fw-bold">{{ ('status.' ~ status) | trans({}, 'tasks')  }}</p>
                </div>
                <div class="col px-4 sortable-col h-100"  data-status="{{ status }}">
                {% for task in tasks %}
                    {% if task.currentContent.status === status %}
                        {% include 'partials/_taskCard.html.twig' with {'task': task } %}
                    {% endif %}
                {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
